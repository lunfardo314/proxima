# Use the official Golang image as the base image
FROM golang:1.26.0-bookworm AS deps

# --- Dependency layer (caches go.mod/go.sum) ---
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

# --- Build layer (single Go toolchain) ---
FROM golang:1.26.0-bookworm AS build

# Reuse module cache from deps stage (via BuildKit cache mount)
WORKDIR /src

# Copy the full source tree (except files filtered by .dockerignore)
COPY . .

WORKDIR /src

# Install git for SetupSequencer build (will be removed later)
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
# Ensure the output directory exists for the binaries
RUN mkdir -p /app

# Build both binaries in parallel, using build cache for Go packages
RUN ls -la /src
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/root/go/pkg/mod \
    go build -trimpath -ldflags="-s -w" -o /app/proxima . && \
    git clone https://github.com/HM4704/SetupProximaSequencer.git /tmp/SetupProximaSequencer && \
    cd /tmp/SetupProximaSequencer && \
    go build -trimpath -ldflags="-s -w" -o /app/SetupSequencer && \
    rm -rf /tmp/SetupProximaSequencer && \
    apt-get purge -y --auto-remove git

# Initialize genesis (runs with the freshly built binary)
WORKDIR /app
RUN ./proxima init genesis

# --- Runtime stage (tiny image) ---
FROM busybox:stable AS runtime
WORKDIR /app

# Before (when context was ../../.. i.e. parent of proxima/)
COPY --from=build /src/tests/docker/boot/* ./
COPY --from=build /src/tests/docker/* ./

# Copy only the required binaries and config files from the build stage
COPY --from=build /app/proxima ./proxima
COPY --from=build /app/SetupSequencer ./SetupSequencer
COPY --from=build /src/tests/docker/boot/* ./    # still correct
COPY --from=build /src/tests/docker/* ./         # still correct


# Remove unnecessary build artifacts from the image
RUN rm -f ./build.sh ./docker-compose.yml ./dockerfile ./run.sh ./stop.sh

# Default command (override with your own entrypoint as needed)
CMD ["./proxima"]
