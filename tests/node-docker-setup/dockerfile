# syntax=docker/dockerfile:1

FROM golang:1.26.0-bookworm AS build

WORKDIR /src

# Copy dependency files first.
# This layer only changes when Go dependencies change.
COPY go.mod go.sum ./

# Persist Go module and compiler caches between builds.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download

# Now copy the source code.
# Changes here won't invalidate the dependency layer above.
COPY . .

# Build
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    mkdir -p /app && \
    go build -trimpath -ldflags="-s -w" -o /app/proxi ./proxi && \
    go build -trimpath -ldflags="-s -w" -o /app/proxima .

# Runtime
FROM busybox:stable AS runtime

WORKDIR /app

COPY --from=build /src/tests/node-docker-setup/node/ ./
COPY --from=build /app/proxima ./proxima
COPY --from=build /app/proxi ./proxi
