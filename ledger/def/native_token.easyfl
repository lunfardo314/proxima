// Native (tagged) tokens.
//
// - tokenAmount(tag, amount): extras carried by any non-foundry UTXO
//   holding native tokens. tag is the foundry chain ID (32 bytes); amount
//   is the carried quantity (uint64, > 0).
// - foundry(tag, supply): extras at foundryConstraintIndex on a foundry
//   output (the chain whose ID equals tag). Carries circulating supply
//   and enforces the tag-equals-chain-ID invariant at every transit.
//
// The optional policy script at foundryPolicyConstraintIndex (if any) is
// raw EasyFL bytecode and is auto-evaluated as part of the standard
// output-tuple validation pass. foundry() does NOT enforce immutability
// of that index across transit: it is up to the policy script itself to
// self-lock (typically via `selfImmutableOnSuccessorIndex(...)`). Any
// further extras after the foundry are not the foundry's concern.
//
// Per-tag preservation, literal-arg enforcement of tokenAmount, and the
// mint/burn balance equation live in the Go `token(...)` builtin.

// $0 token tag (32 bytes, equal to the foundry chain ID)
// $1 token amount (uint64, > 0)
func tokenAmount :
or(
   not(selfIsProducedOutput),
   and(
      require(equal(len($0), u64/32), !!!tokenAmount_tag_must_be_32_bytes_long),
      require(not(isZero($1)), !!!tokenAmount_amount_must_be_non_zero)
   )
)

// _selfIsFoundryOrigin returns truthy iff the chain at chainConstraintIndex
// is at origin (chain.ChainID == NilChainID). Same shape as
// _selfIsDelegationOrigin in lock_delegate.easyfl.
func _selfIsFoundryOrigin :
   isChainOriginID(parseInlineDataArgument(selfSiblingConstraint(chainConstraintIndex), 0, #chain))

// $0 token tag (32 bytes)
//   at origin: unconstrained (chain.ChainID is still NilChainID)
//   at transit: must equal the chain ID at chainConstraintIndex
// $1 circulating supply (uint64, z-encoded - at most 8 bytes after the
//   data prefix)
func foundry :
or(
   not(selfIsProducedOutput),
   and(
      require(equal(len($0), u64/32), !!!foundry_tag_must_be_32_bytes_long),
      require(lessOrEqualThan(len($1), u64/8), !!!foundry_supply_must_be_at_most_8_bytes_long),
      require(
         or(
            _selfIsFoundryOrigin,
            equal($0, parseInlineDataArgument(selfSiblingConstraint(chainConstraintIndex), 0, #chain))
         ),
         !!!foundry_tag_must_equal_chain_ID_at_transit
      )
   )
)

// =====================================================================
// Predefined foundry policy scripts.
//
// Each policy AND-s `selfImmutableOnSuccessorIndex(foundryPolicyConstraintIndex)`
// with its policy-specific check so that the policy script body is itself
// immutable across every chain transit. Without that self-lock the
// foundry owner could swap the policy out at any time.
// =====================================================================

// foundryNonDestructible: allow the foundry chain to be discontinued
// only when the consumed foundry's supply is 0. All minted tokens must
// have been burned back into the foundry before retirement.
//
// On the produced side and on the consumed side of a continuing chain
// the body is a no-op; the self-immutability helper covers transit.
func foundryNonDestructible :
and(
   selfImmutableOnSuccessorIndex(foundryPolicyConstraintIndex),
   or(
      not(selfIsConsumedOutput),
      not(equal(len(_chainSuccessorOutputIndex), u64/0)),
      require(
         isZero(parseInlineDataArgument(selfSiblingConstraint(foundryConstraintIndex), 1, #foundry)),
         !!!cannot_destroy_foundry_with_non_zero_supply
      )
   )
)

// $0 - max supply (uint64 literal, z-encoded, <=8 bytes after the
//   inline-data prefix)
// foundryMaxSupply($0): on every transit (including origin) requires
// produced foundry supply <= $0.
func foundryMaxSupply :
and(
   selfImmutableOnSuccessorIndex(foundryPolicyConstraintIndex),
   or(
      not(selfIsProducedOutput),
      require(
         lessOrEqualThan(
            uint8Bytes(parseInlineDataArgument(selfSiblingConstraint(foundryConstraintIndex), 1, #foundry)),
            uint8Bytes($0)
         ),
         !!!foundry_supply_exceeds_max_supply
      )
   )
)