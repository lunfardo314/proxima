// tagAlong is a tiny fee output sent to a specific sequencer chain (target)
// from a specific user (sender). The sequencer can spend it during the
// tag-along window, or the sender can reclaim it after that window expires.
//
// The public lock symbol `tagAlong` is a 0-arg constraint — its bytecode at
// the lock element carries no data. The (sender, target) pair lives only in
// the index-value tuple: position 0 = senderID (master, by §4.1 convention),
// position 1 = targetSequencerID. The wrapper threads them into `_tagAlong`
// (which keeps the original target-first arg ordering).

func constTagAlongSlots : u64/30  // 5 min
func constTagAlongReclaimSlots : u64/390 // 5 min + 1 hour

func selfInputSlotPace: sub(txSlot, slotOfInputByIndex(selfOutputIndex))

// $0 - target sequencer ID (32 bytes), supplied by the public wrapper
// $1 - sender holder ID (32 bytes), supplied by the public wrapper
func _tagAlong :
or(
  and(
     selfIsProducedOutput,
     require(equal(selfBlockIndex, lockConstraintIndex), !!!locks_must_be_at_lockConstraintIndex),
	 require(equal(len($0),u64/24), !!!24-byte_long_argument_expected),
	 require(not(isZero($0)), !!!non_zero_argument_expected),   // to prevent common error
     require(lessThan(selfNumConstraints, u64/6), !!!tag-along_lock_allows_no_more_than_5_UTXO_elements),
     require(
        equal($1, txHolderID(txSignatureData)),
        !!!sender_hash_check_failed
     )
  ),
  and(
     selfIsConsumedOutput,
	 or(
		greaterOrEqualThan(selfInputSlotPace, constTagAlongReclaimSlots),  // unlockable by anybody
		and(
			 // unlockable by the target
		   lessThan(selfInputSlotPace, constTagAlongSlots),
		   require(_chainLock($0), !!!unlock_window_error:_inside_tag_along_slots_must_be_unlocked_by_the_target)
		),
			 // unlockable by the sender
        require(
           _sigLock($1),
           !!!unlock_window_error:_inside_reclaim_slots_must_be_unlocked_by_the_sender
        )
	 )
  )
)

// public 0-arg lock — sender / target come from the index-value tuple
// (sender at position 0 per §4.1 master-first convention; target at position 1).
func tagAlong : _tagAlong(selfIndexValue(1), selfIndexValue(0))
