// mineLock — the fair-launch mine chain lock.
//
// It sits at the lock element (output index 2) of the single genesis mine
// chain UTXO and enforces the ENTIRE mining policy by itself. It is an OPEN
// lock: anyone can spend the mine output (no per-output signature); the one
// mandatory transaction signature (tx_integrity_validator) identifies the
// miner and is the holder the reward is paid to.
//
// Bytecode arguments (mutable per-transit state; the emission schedule A, the
// difficulty band E, C, the minimum pace P, the harden count and the fee live
// in ledger constants):
//   $0 R  (z64)  remaining mintable motes; decreases by A each transit
//   $1 B  (z64)  current difficulty (bits); seeded from constMineBaseDifficulty
//                and retargeted per transit (see _mineAdjustedB)
//   $2 C  (z64)  full slots in a row since the last harden (see _mineAdjustedC)
//
// The pace is one step per slot. The retarget sees only the gap
// M = successorSlot - predecessorSlot, which at pace 1 says "at least one
// solution in the slot" (M = 1, a full slot) or "none" (M >= 2, empty slots),
// never how many solutions competed. A symmetric controller would therefore
// settle with half the slots empty; the retarget is asymmetric instead: it
// hardens one bit after constMineHardenAfter full slots in a row and eases one
// bit per empty slot, so the equilibrium leaves about one slot in
// constMineHardenAfter + 1 empty and every full slot holds a couple of
// competing solutions, which the sequencers settle by the canonical winner rule
// (kb/mine_conflict_rule.md). Beyond the difficulty ceiling nothing breaks:
// the slots are simply all full.
//
// The required difficulty depends on the pace: K = max(B - (M - P), E), where P
// is the minimum pace and E the floor. At the minimum pace M = P the full B is
// required; each extra slot of pace eases one bit. That gives liveness for
// free: as M grows K falls to E, so however far B sits above the network's
// hashrate, waiting long enough always makes a transit solvable and the chain
// cannot wedge.

// ---- accessors on the transition (evaluated in the CONSUMED context, where
// `self` is the predecessor mine output being spent) ----

// successor mine output index, from this output's chain unlock parameters
func _mineSuccIdx  : byte(selfSiblingUnlockParams(chainConstraintIndex), 0)
func _mineSuccPath : concat(pathToProducedOutputs, _mineSuccIdx)
func _mineSuccLock : atPath(concat(_mineSuccPath, lockConstraintIndex))
// $0 argument index in the successor's mineLock bytecode
func _mineSuccArg       : parseInlineDataArgument(_mineSuccLock, $0, #mineLock)
func _mineSuccInflation : amountAt(atPath(concat(_mineSuccPath, amountsConstraintIndex)), 1)

// predecessor slot and pace M = successor slot - predecessor slot
func _minePredSlot : slotOfInputByIndex(selfOutputIndex)
func _mineM        : sub(txSlot, _minePredSlot)

// produced output [i] lock bytecode and the payout holder / amounts
// $0 output index
func _mineOutLock    : atPath(concat(pathToProducedOutputs, $0, lockConstraintIndex))
func _minePayoutHolder : atPath(concat(pathToProducedOutputs, 1, indexValuesConstraintIndex, 0))
func _minePayout     : tokenBalanceByOutputPath(concat(pathToProducedOutputs, 1))
func _mineTagAlong   : tokenBalanceByOutputPath(concat(pathToProducedOutputs, 2))

// ---- emission schedule: the amount A minted per transit ----

// A is flat at constMineAmountBase up to and including constMineRampStartSlot,
// then grows by constMineAmountPerSlot per slot. Nothing caps the growth here
// because R does: the chain stops when what is left of R cannot cover a transit.
//
// The base amount is chosen so that the flat phase alone carries mined supply to
// the point where the genesis capital can no longer commit a healthy branch on
// its own, so the reward is constant for as long as one party still controls the
// network and starts growing the moment that stops being true. Growing afterwards keeps a
// transit worth attempting as difficulty climbs with hashrate, which is what
// carries the tail to exhaustion.
//
// $0 slot
func _mineAmountAtSlot :
if(
   lessOrEqualThan(uint8Bytes($0), uint8Bytes(constMineRampStartSlot)),
   constMineAmountBase,
   add(
      constMineAmountBase,
      mul(sub($0, constMineRampStartSlot), constMineAmountPerSlot)
   )
)

// A for the transaction being validated. Every use of A below - the exhaustion
// guard, the successor's inflation and R decrement, the payout and tag-along
// caps - goes through here, so one transaction is checked against one A.
func _mineAmount : _mineAmountAtSlot(txSlot)

// ---- required difficulty (pace-relieved) ----

// $0 B, $1 M (pace, >= P) -> the difficulty K a transit at gap M must satisfy:
// K = max(B - (M - P), E). At the minimum pace M = P it is the full B; each extra
// slot of pace eases one bit, floored at E. The pace check guarantees M >= P, so
// M - P never underflows, and B >= E always (clamped), so B - E never does. This
// is what linearizes pace-vs-B (§8): the winning pace tracks B one slot per bit,
// letting the retarget hold the target, and it doubles as the liveness valve
// (K -> E as M grows, so a chain can never wedge on difficulty).
func _mineRequiredK :
if(
   lessOrEqualThan(uint8Bytes(sub($0, constMineFloorDifficulty)), uint8Bytes(sub($1, constMineMinPace))),
   constMineFloorDifficulty,
   sub($0, sub($1, constMineMinPace))
)

// ---- adaptive retarget ----

// one bit up, clamped at the ceiling C. $0 = B
func _mineHarder :
if(
   lessOrEqualThan(uint8Bytes(constMineMaxDifficulty), uint8Bytes($0)),
   constMineMaxDifficulty,
   add($0, u64/1)
)

// one bit down per empty slot (M - 1 of them at gap M >= 2), floored at E. $0 = B
func _mineEased :
if(
   lessOrEqualThan(uint8Bytes(sub($0, constMineFloorDifficulty)), uint8Bytes(sub(_mineM, u64/1))),
   constMineFloorDifficulty,
   sub($0, sub(_mineM, u64/1))
)

// a full slot: the successor follows its predecessor by exactly one slot
func _mineFullSlot : equalUint(_mineM, u64/1)

// $0 C -> this full slot completes a run of constMineHardenAfter full slots
func _mineHardens : and(_mineFullSlot, equalUint(add($0, u64/1), constMineHardenAfter))

// The genesis mine output is at slot 0, so the very first transit sees
// M = txSlot - 0 (meaningless); while the predecessor is genesis, B and C are
// held.

// $0 B, $1 C -> the difficulty the successor must carry: hardened one bit when
// this full slot completes the run, eased one bit per empty slot, else held
func _mineAdjustedB :
if(
   isZero(_minePredSlot),
   $0,
   if(
      _mineFullSlot,
      if(_mineHardens($1), _mineHarder($0), $0),
      _mineEased($0)
   )
)

// $0 B, $1 C -> the full-slot count the successor must carry: reset when the
// run completes, one more on a full slot, unchanged over empty slots
func _mineAdjustedC :
if(
   isZero(_minePredSlot),
   $1,
   if(
      _mineFullSlot,
      if(_mineHardens($1), u64/0, add($1, u64/1)),
      $1
   )
)

// PoW: the ECVRF output (RFC 9381) under the signer's key over
// alpha = predecessor output ID || txSlot || nonce must end in >= K zero bits.
// The proof and the nonce ride in this output's unlock parameters:
//   [0:80)  pi     ECVRF-EDWARDS25519-SHA512-TAI proof (Gamma || c || s)
//   [80:88) nonce  free, the miner's search variable
// A VRF output is unique per (key, message), so an attempt costs a genuine
// hash-to-curve plus a variable-base scalar multiplication under the miner's
// key: nothing to increment or batch, and the key must be present, which is
// what keeps the work non-outsourceable. (A hash over the signed transaction,
// the previous work function, left the signature nonce free, so an attempt
// could cost one point addition instead of a scalar multiplication.)
// The predecessor ID binds the work to this transit, the slot to one target.
func _mineProof  : slice(selfUnlockParameters, 0, 79)
func _mineNonce  : slice(selfUnlockParameters, 80, 87)
func _mineAlpha  : concat(inputIDByIndex(selfOutputIndex), txSlot, _mineNonce)
func _mineBeta64 : tail(vrfProofToHash(_mineProof), 56)

// Test on the low 64 bits (K < 64): clearing the low K bits must leave the
// value unchanged. $0 = low-64-bit slice of the VRF output, $1 = K.
func _minePoWOK : equal(lshift64(rshift64($0, $1), $1), $0)

// chain ID this output's own chain constraint carries
func _mineSelfChainID : parseInlineDataArgument(selfSiblingConstraint(chainConstraintIndex), 0, #chain)

// ---- produced (successor) arm ----
// The predecessor's consumed arm below validates every field of the successor.
// The only thing that must be pinned on the successor itself is that it lives
// on the one mine chain: this is what makes mineLock invalid anywhere else.
// (The genesis mine output carries an explicit chain constraint and is
// inserted directly into the state, never validated through this arm.)
func _mineProduced :
and(
   selfIsProducedOutput,
   require(equal(_mineSelfChainID, constMineChainID), !!!mineLock_is_only_valid_on_the_mine_chain)
)

// ---- consumed (predecessor) arm: the full static transaction template ----
// It is split into small groups only because a single EasyFL call is limited
// to 15 arguments. Order matters: _mineShape runs first and short-circuits, so
// its guards (chain continues, successor at index 0) protect the successor
// accessors used by the later groups.

// static shape: not exhausted, the pace M >= P (checked first: the retarget
// below counts empty slots as M - 1, which a same-slot successor would
// underflow), exactly one input and three produced outputs, the chain
// continues, and its successor at index 0 is again a mine output.
// $0 R
func _mineShape :
and(
   selfIsConsumedOutput,
   require(lessOrEqualThan(uint8Bytes(_mineAmount), uint8Bytes($0)), !!!mine_chain_is_exhausted),
   require(lessOrEqualThan(uint8Bytes(constMineMinPace), uint8Bytes(_mineM)), !!!mine_pace_below_minimum),
   require(equalUint(numInputs, u64/1), !!!mine_transaction_must_have_exactly_one_input),
   require(equalUint(numProducedOutputs, u64/3), !!!mine_transaction_must_have_exactly_three_outputs),
   require(equalUint(len(selfSiblingUnlockParams(chainConstraintIndex)), u64/1), !!!mine_chain_must_continue),
   require(isZero(_mineSuccIdx), !!!mine_successor_must_be_at_output_index_0),
   require(equal(parseBytecode(_mineSuccLock, 0x), #mineLock), !!!mine_successor_must_carry_mineLock)
)

// successor state: mints A (balance unchanged, inflation == A), R decrements,
// B and C are retargeted by _mineAdjustedB and _mineAdjustedC.
// $0 R  $1 B  $2 C
func _mineSuccessorState :
and(
   require(equalUint(tokenBalanceByOutputPath(_mineSuccPath), selfTokenBalanceValue), !!!mine_successor_balance_must_equal_predecessor),
   require(equalUint(_mineSuccInflation, _mineAmount), !!!mine_successor_inflation_must_equal_A),
   require(equalUint(_mineSuccArg(0), sub($0, _mineAmount)), !!!wrong_R_on_mine_successor),
   require(equalUint(_mineSuccArg(1), _mineAdjustedB($1, $2)), !!!wrong_difficulty_on_mine_successor),
   require(equalUint(_mineSuccArg(2), _mineAdjustedC($1, $2)), !!!wrong_full_slot_count_on_mine_successor)
)

// payout [1]: sig-locked to the transaction signer, amount A' = A - T. Tying
// the reward to the signer's holder ID is what makes mining non-outsourceable:
// outsourcing the key means risking the reward. tag-along [2]: the fee T is a
// fixed amount, constMineTagAlongFee, the same for every transit: it cannot be
// raised to buy inclusion or to pay a third party, and the payout follows by
// amount conservation.
func _minePayoutAndFee :
and(
   require(equal(parseBytecode(_mineOutLock(1), 0x), #sigLock), !!!mine_payout_output_must_be_sig_locked),
   require(equal(_minePayoutHolder, txHolderID(txSignatureData)), !!!mine_payout_must_go_to_the_transaction_signer),
   require(lessOrEqualThan(uint8Bytes(_minePayout), uint8Bytes(_mineAmount)), !!!mine_payout_exceeds_A),
   require(equal(parseBytecode(_mineOutLock(2), 0x), #tagAlong), !!!mine_output_at_index_2_must_be_tag_along),
   require(equalUint(_mineTagAlong, constMineTagAlongFee), !!!mine_tag_along_fee_must_be_the_fixed_amount)
)

// VRF-bound proof of work at K = _mineRequiredK(B, M) = max(B - (M - P), E):
// full B at the minimum pace, one bit easier per extra slot (M >= P is
// guaranteed by _mineShape). The proof is verified under the transaction
// signer's key, which _minePayoutAndFee pins as the payout holder: prover,
// signer and payee are one key. $0 B
func _minePaceAndPoW :
and(
   require(equalUint(len(selfUnlockParameters), u64/88), !!!mine_unlock_params_must_be_VRF_proof_and_nonce),
   require(vrfVerify(signaturePublicKey(txSignatureData), _mineAlpha, _mineProof), !!!mine_VRF_proof_check_failed),
   require(_minePoWOK(_mineBeta64, _mineRequiredK($0, _mineM)), !!!insufficient_mine_proof_of_work)
)

// $0 R  $1 B  $2 C
func _mineConsumed :
and(
   _mineShape($0),
   _mineSuccessorState($0, $1, $2),
   _minePayoutAndFee,
   _minePaceAndPoW($1)
)

// $0 R  $1 B  $2 C
func mineLock :
and(
   require(equal(selfBlockIndex, lockConstraintIndex), !!!locks_must_be_at_lockConstraintIndex),
   or(
      _mineProduced,
      _mineConsumed($0, $1, $2)
   )
)
