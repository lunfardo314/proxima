// inflation related definitions

// ------ chain inflation is rewards for holders of chained accounts. It is linear and homogenous in time ---------

// maximum inflation of the total initial supply in slot 0
func constSlotInflationBase: u64/33000000

// minimum amount which gives non-zero inflation in the slot 0 (3030303 at slot 0)
func minimumInflatableAmount0: div(constInitialSupply, constSlotInflationBase)

// --- canonical pre-image P for branch-inflation-bonus mining --------------
// P is the producing transaction bytes with four fields zeroed:
//   1) the whole sequencer output (multiple fields on it depend on B —
//      amounts[0]=pred+B, amounts[1]=B, chain.cumulativeBranchBonus=pred+B —
//      so zero the entire output to break the circularity in one cut)
//   2) the whole stem output (its stemLock carries slotInflation and
//      TotalSupply, which are also B-dependent in the canonical sequencer
//      flow — zeroing the output lets the sequencer fill them correctly
//      after B is known)
//   3) TxConstraints[1] (the mining signature S) — S depends on P
//   4) the transaction signature (TxSignatureData, tx-tuple index 3)
// Built via nested replaceTupleElement calls; used by branchInflationBonus
// to compute B = blake2b(P || S) mod M + 1. The nonce at TxConstraints[0]
// stays in P — varying it is what makes mining work.

// outputs tuple with sequencer and stem outputs zeroed entirely
func _canonicalOutputs :
  replaceTupleElement(
    replaceTupleElement(
      atPath(pathToProducedOutputs),
      txSequencerOutputIndex, 0x
    ),
    txStemOutputIndex, 0x
  )

// TxConstraints with the mining-signature S (index 1) zeroed
func _canonicalTxConstraints :
  replaceTupleElement(
    atPath(pathToTxConstraints),
    1, 0x
  )

// miningSigOnTx: the raw ED25519 signature S = sign(canonicalP) under the
// sequencer's controller key. Lives at TxConstraints[1] (branch txs only).
func miningSigOnTx : parseInlineData(atPath(concat(pathToTxConstraints, 1)))

// canonical pre-image P: tx-tuple bytes with outputs (idx 8), TxConstraints
// (idx 10) and tx-signature (idx 3) all replaced with their canonicalised
// versions.
func canonicalP :
  replaceTupleElement(
    replaceTupleElement(
      replaceTupleElement(txBytes, 8, _canonicalOutputs),
      10, _canonicalTxConstraints
    ),
    3, 0x
  )

// branchInflationBonus($0): B = blake2b($0 || S) mod M + 1
// $0 must be canonicalP. Caller is responsible for computing it once per
// validation and threading it through — the formula is identical no matter
// how many times it is invoked, but evaluating canonicalP is expensive
// (4 nested replaceTupleElement passes over the tx tuple), so callers
// MUST share a single evaluation across all references within the same
// constraint.
func branchInflationBonus : add(randomFromSeed(concat($0, miningSigOnTx), branchInflationBonusBase(txSlot)), u64/1)

// calculates one-slot inflation in slot $0 of amount $1
func chainInflationOneSlot: div($0,add(minimumInflatableAmount0,$1))

// calculates chain inflation generated  in $2 steps by amount $0 starting at slot $1
func chainInflationMultiStep: mul($2,chainInflationOneSlot($0,$1))

// ------- branch inflation bonus is VRF-base pseudo-random value with the upper bound that depends on the slot.
// Branch inflation bonus upper bound starts from 65.000.000 immediately after bootstrap grace slots,
// then linearly monthly declines down to the tail inflation bonus of 5.000.000. After 1 year
// upper bounds becomes constant tail branch inflation bonus

// number of slots in a 30-day month: 30*24*3600 / 10.24 = 253125
// rounded to 255118 to account for slot duration precision
func constSlotsPerMonth : u64/255118

// number of 30-day months after bootstrap grace period during which
// initial large branch inflation bonus base linearly goes down to the tail value
// month 0: 5M*13=65M, month 12: 5M*1=5M, month 13+: tail 5M
func constBranchInflationBonusBaseGenesisSlopeMonths : u64/12

// $0 - number of months since genesis (div(slot, constSlotsPerMonth))
func branchInflationBonusBaseSchedule :
if(
   lessThan($0, constBranchInflationBonusBaseGenesisSlopeMonths),
   mul(constBranchInflationBonusBaseTail, sub(add(constBranchInflationBonusBaseGenesisSlopeMonths, u64/1), $0)),
   constBranchInflationBonusBaseTail,
)

// maximum value of the branch inflation bonus at slot $0
func branchInflationBonusBase: branchInflationBonusBaseSchedule(div($0, constSlotsPerMonth))

// branch inflation bonus base tail constant
func constBranchInflationBonusBaseTail : u64/5000000
