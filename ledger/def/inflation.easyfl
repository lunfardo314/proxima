// inflation related definitions

// ------ chain inflation is rewards for holders of chained accounts. It is linear and homogenous in time ---------

// maximum inflation of the total initial supply in slot 0
func constSlotInflationBase: u64/33000000

// minimum amount which gives non-zero inflation in the slot 0.
// Anchored on the target base supply (not the smaller genesis supply) so the
// dust threshold is invariant to the fair-launch genesis/mining split.
func minimumInflatableAmount0: div(constTargetBaseSupply, constSlotInflationBase)

// calculates deterministic pseudo-random value of branch inflation bonus based on VRF in $0 and slot $1
func branchInflationBonus : add(randomFromSeed($0, branchInflationBonusBase($1)), u64/1)

// calculates one-slot inflation in slot $0 of amount $1
func chainInflationOneSlot: div($0,add(minimumInflatableAmount0,$1))

// calculates chain inflation generated  in $2 steps by amount $0 starting at slot $1
func chainInflationMultiStep: mul($2,chainInflationOneSlot($0,$1))

// ------- branch inflation bonus is a VRF-based pseudo-random value whose upper bound
// (branchInflationBonusBase) is a FLAT constant from genesis: constBranchInflationBonusBaseTail
// (5.000.000). The earlier bootstrap schedule — high at genesis (65M), declining monthly to
// the tail over the first year — was removed so the base is constant since slot 0.

// maximum value of the branch inflation bonus at slot $0. evalArg1($0, X) keeps the
// 1-arg signature (callers pass the slot) while returning the slot-independent tail.
func branchInflationBonusBase: evalArg1($0, constBranchInflationBonusBaseTail)

// branch inflation bonus base tail constant
func constBranchInflationBonusBaseTail : u64/5000000
