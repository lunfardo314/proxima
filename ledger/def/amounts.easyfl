// a vector of amounts. Serialized as variable size argument list from 0 to 15 arguments
// - amount on absent arg is considered u64/0
// - index 0 is token balance
// - index 1 is inflation
// - indices 2 to 12 (inclusive) is frozen coverage
// - indices 12, 14 are uninterpreted. Can be enforced by transaction level constraints for implementation of native tokens and similar
func_vararg amounts :
require(
   isZero(selfBlockIndex),
   !!!'amounts'_must_be_at_index_0
)

// $0 - 'amounts'' bytecode
// $1 - index of 'amounts' vector element, 1 byte
func amountAt:
if(
   lessThan($1, parseNumArgs($0)),
   uint8Bytes(parseInlineDataArgument($0, $1, #amounts)),
   u64/0
)

// $0 path to output
func tokenBalanceByOutputPath : amountAt(atPath(concat($0, amountsConstraintIndex)), 0)

func selfTokenBalanceValue: amountAt(selfSiblingConstraint(amountsConstraintIndex),0)