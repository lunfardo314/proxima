
// Index of the first frozen-coverage cell in the amounts vector.
// Mirrors ledger.AmountIndexFrozenCoverage.
func amountIndexFrozenCoverage : u64/3

// $0 - 'amounts'' serialized tuple
// $1 - index of 'amounts' vector element, 1 byte
//
// Cells past the end of the tuple read as 0, which is what elides the trailing
// zeros of an ordinary output. The frozen-coverage region needs
// frozenCoverageAt instead: there the encoding also collapses a repeating run.
func amountAt:
if(
   lessThan(uint8Bytes($1), tupleLen($0)),
   uint8Bytes(atTuple8($0, $1)),
   u64/0
)

// $0 - 'amounts'' serialized tuple
//
// Number of epochs the frozen-coverage cells cover, read from the cell between
// the scalars and the vector (ledger.AmountIndexFrozenCoverageBound). 0 means
// the output carries no frozen coverage at all. It is a bound, not an amount:
// the per-index sums over consumed and produced outputs skip it.
func frozenCoverageBound : amountAt($0, 2)

// $0 - 'amounts'' serialized tuple
// $1 - epoch offset, 1 byte
//
// Frozen coverage of the output at the given epoch offset: 0 from the bound on,
// otherwise the cell of that epoch or, where the encoder collapsed the run, the
// last cell of the tuple. Coverage is constant over a delegation's frozen span,
// so the bound plus the first cell of the run describe the whole vector: a
// delegation costs a couple of cells instead of one per epoch, whatever the
// span. Without the bound the zeros past the span would have to be spelled out,
// which would in turn force out every cell of the run before them.
func frozenCoverageAt :
if(
   or(
      lessOrEqualThan(frozenCoverageBound($0), uint8Bytes($1)),
      lessOrEqualThan(tupleLen($0), amountIndexFrozenCoverage)
   ),
   u64/0,
   uint8Bytes(atTuple8($0, _frozenCoverageCellIndex($0, $1)))
)

// index of the cell holding the frozen coverage at epoch offset $1: the cell of
// that epoch, or the last cell of the tuple when the run was collapsed
func _frozenCoverageCellIndex :
if(
   lessThan(add(amountIndexFrozenCoverage, uint8Bytes($1)), tupleLen($0)),
   byte(add(amountIndexFrozenCoverage, uint8Bytes($1)), 7),
   byte(sub(tupleLen($0), u64/1), 7)
)

// $0 path to output
func tokenBalanceByOutputPath : amountAt(atPath(concat($0, amountsConstraintIndex)), 0)

func selfTokenBalanceValue: amountAt(selfSiblingConstraint(amountsConstraintIndex),0)

// no args.
// Enforces all 0 in inflation and frozen coverage on non-chained output
func selfEnforceZeroAmountsInNonChainedOutput :
require(
   or(selfIsChainedOutput, embeddedIsInflationAndFrozenCoverageZero),
   !!!inflation_and_frozen_coverage_must_all_be_0_on_non-chained output
)

// inflation amount from the amounts constraint of the current output
func selfInflationAmount : amountAt(selfSiblingConstraint(amountsConstraintIndex), 1)
