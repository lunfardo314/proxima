// $0 explicit baseline bytes
func _mustValidExplicitBaseline :
or(
   isZero(len($0)), // not set
   and(
      require(isSequencerTransaction, !!!explicit_baseline:_can_only_be_set_on_a_sequencer_transaction),
      require(equal(len($0),u64/32), !!!explicit_baseline:_must_be_32_bytes_long_txid),
      require(branchFlagON($0), !!!"explicit_baseline:_must_be_a_branch_transaction_ID),
      require(lessThan(u64/0, sub(txSlot, slice($0,0,3))), !!!explicit_baseline:_must_point_to_a_transaction_at_least_1_slot_in_the_past)
   )
)

func _validEndorsements :
and(
   require(
      or(isZero(tupleLenAtPath(pathToEndorsements)), isSequencerTransaction),
      !!!only_sequencer_transactions_can_endorse
   ),
   require(
      lessOrEqualThan(tupleLenAtPath(pathToEndorsements), constMaxNumberOfEndorsements),
      !!!number_of_endorsements_too_big
   ),
   require(
      not(tupleHasDuplicatesAtPath(pathToEndorsements)),
      !!!duplicated_endorsements_not_allowed
   )
)

// partial context: does not require consumed UTXOs
func txIntegrityValidatorPartialContext0 : and(
   // enforce number of inputs is not 0 and equal to the number of unlock params
   require(
      and(
         not(isZero(tupleLenAtPath(pathToInputIDs))),
         equal(tupleLenAtPath(pathToInputIDs), tupleLenAtPath(pathToUnlockParams)),
      ),
      !!!number_of_unlock_params_must_be_equal_to_the_number_of_inputs
   ),
   // inputs should not contain duplicates
   require(
      not(tupleHasDuplicatesAtPath(pathToInputIDs)),
      !!!inputs_cannot_contain_duplicates
   ),
   // check signature of the transaction
   require(
      validSignature(txID, txSignatureData),
      !!!invalid_signature_of_the_transaction
   ),
   // check endorsements
   _validEndorsements,
   // check explicit baseline
   _mustValidExplicitBaseline(txExplicitBaseline)
)

// full context: does require consumed UTXOs
func txIntegrityValidatorFullContext0 :
and(
   // check input commitment, in order to prevent "fake UTXOs" attack from malicious node
   require(
      equal(atPath(pathToInputCommitment),blake2b(atPath(pathToConsumedOutputs)) ),
      !!!hash_of_consumed_UTXOs_not_equal_to_the_input_commitment
   )
)