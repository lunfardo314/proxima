// =============================================================================
// DEX order locks — sellOrder / buyOrder, plus the optional
// randomizeConsumption helper. Spec: claude/archive/shipped/dex_orders.md.
//
// Public symbols (lock element at UTXO position 2):
//   - sellOrder(price, timeoutSlots)
//   - buyOrder(amount, price, timeoutSlots)
//   - randomizeConsumption(N)  [optional anti-contention helper]
//
// Helpers are underscore-private. Body was originally prototyped as a
// callRedeemer-invoked local script in examples/dex/dex.easyfl; this file
// is the Phase-2 graduation into the base ledger library (identical body,
// reached directly as a public constraint rather than via callRedeemer).
// =============================================================================

// ---- constants ------------------------------------------------------------

// "ORDR" — 4-byte ASCII prefix for the index-values position-1 entry.
func _ordrPrefix : 0x4f524452

// Side bytes: 0x00 = buy, 0x01 = sell. Lexicographic order in the trie
// puts bids before asks within a given tag.
func _sideBuy  : 0x00
func _sideSell : 0x01

// Minimum timeout window (slots) — ~2 minutes at slot pace 12.
func _minTimeoutSlots : u64/12

// Randomize bounds.
func _minRandomizeN : u64/2
func _maxRandomizeN : u64/32

// ---- generic helpers ------------------------------------------------------

// Δ = txSlot − slotOfConsumedOrder. Same idiom as tagAlong.
func _inputSlotPace : sub(txSlot, slotOfInputByIndex(selfOutputIndex))

// Slice fields out of the "ORDR || tag || side" index entry.
// 0..3 = "ORDR" (4 bytes), 4..27 = tag (24 bytes), 28 = side byte.
func _entryPrefix : slice($0, 0, 3)
func _entryTag    : slice($0, 4, 27)
func _entrySide   : byte($0, 28)

// Consumed-order accessors (used on consume-side checks).
// selfOutputIndex on consume-side is the order's input index.
func _consumedOrderIssuer : consumedIndexValueByIndex(selfOutputIndex, 0)
func _consumedOrderEntry  : consumedIndexValueByIndex(selfOutputIndex, 1)
func _consumedOrderTag    : _entryTag(_consumedOrderEntry)
func _consumedOrderBase :
   amountAt(consumedConstraintByIndex(selfOutputIndex, 0), 0)
func _consumedSellAmount :
   parseInlineDataArgument(
      consumedConstraintByIndex(selfOutputIndex, 3),
      1, #tokenAmount)

// Receipt accessors — PUBLIC, SHARED. $0 = receipt output index (1 byte
// from unlock params). These are a generic "produced output at index $0"
// receipt-validation API: a sigLock-shaped payout output carrying an
// anti-fold inline literal at position 3. Reused by sellOrder / buyOrder
// here and by returnToSender (def/return_to_sender.easyfl), which is
// introduced after this source so these names resolve. Do not give them a
// `_` prefix — they are intentionally library-public.
func receiptNumConstraints :
   tupleLenAtPath(producedOutputPathByIndex($0))
func receiptAmounts     : producedConstraintByIndex(concat($0, 0))
func receiptSigLock     : producedConstraintByIndex(concat($0, 2))
func receiptLiteral     : producedConstraintByIndex(concat($0, 3))
func receiptTokenAmount : producedConstraintByIndex(concat($0, 4))

// Receipt's index-values position 0 — where sigLock reads its holderID.
func receiptHolderID :
   atPath(concat(producedOutputPathByIndex($0), indexValuesConstraintIndex, 0))

// Receipt base-token balance (amountAt returns uint64 BE, already widened).
func receiptBase : amountAt(receiptAmounts($0), 0)

// Validate the receipt's 1-byte inline-data literal at position 3 equals
// the consumed order's input index (anti-fold defence).
func receiptLiteralMatchesInputIdx :
   equal(parseInlineData(receiptLiteral($0)), selfOutputIndex)

// =============================================================================
// sellOrder(price, timeoutSlots)
//
// $0 = price          (z-encoded, ≤ 8 bytes, > 0)
// $1 = timeoutSlots   (≤ 4 bytes, ≥ _minTimeoutSlots)
//
// Order UTXO produce-side shape:
//   pos 0: amounts (deposit only; zero inflation)
//   pos 1: indexValues(sellerHolderID, ORDR || tag || 0x01)
//   pos 2: callRedeemer(dexHash, sellOrderFnIdx, price, timeoutSlots)  <-- this
//   pos 3: tokenAmount(tag, X)
//   pos 4 (optional): randomizeConsumption(N)  -- not shape-restricted here;
//                     any extra constraint can only further restrict consume.
// =============================================================================

func sellOrder :
or(
   // -------- produce side --------
   and(
      selfIsProducedOutput,
      require(equal(selfBlockIndex, lockConstraintIndex),
              !!!sellOrder:_lock_must_be_at_lockConstraintIndex),
      // arg sanity
      require(not(isZero($0)),                          !!!sellOrder:_price_must_be_positive),
      require(lessOrEqualThan(len($0), u64/8),          !!!sellOrder:_price_must_be_at_most_8_bytes),
      require(lessOrEqualThan(len($1), u64/4),          !!!sellOrder:_timeoutSlots_must_be_at_most_4_bytes),
      require(lessOrEqualThan(_minTimeoutSlots, uint8Bytes($1)),
              !!!sellOrder:_timeoutSlots_below_floor),
      // issuer = signer
      require(equal(len(selfIndexValue(0)), u64/32),
              !!!sellOrder:_issuer_holderID_must_be_32_bytes),
      require(equal(selfIndexValue(0), txHolderID(txSignatureData)),
              !!!sellOrder:_issuer_must_be_tx_signer),
      // index entry shape: ORDR || tag || 0x01
      require(equal(len(selfIndexValue(1)), u64/29),
              !!!sellOrder:_index_entry_must_be_29_bytes),
      require(equal(_entryPrefix(selfIndexValue(1)), _ordrPrefix),
              !!!sellOrder:_index_entry_must_start_with_ORDR),
      require(equal(_entrySide(selfIndexValue(1)), _sideSell),
              !!!sellOrder:_index_entry_side_byte_must_be_0x01),
      // tag in entry must equal tokenAmount's tag at pos 3
      require(
         equal(
            _entryTag(selfIndexValue(1)),
            parseInlineDataArgument(selfSiblingConstraint(3), 0, #tokenAmount)
         ),
         !!!sellOrder:_index_entry_tag_must_equal_tokenAmount_tag
      )
   ),
   // -------- consume side --------
   and(
      selfIsConsumedOutput,
      or(
         // reclaim window: Δ ≥ timeoutSlots — delegate fully to sigLock
         // (issuer's holderID lives at selfIndexValue(0) per produce-side rules).
         and(
            lessOrEqualThan(uint8Bytes($1), _inputSlotPace),
            sigLock
         ),
         // counterparty (buyer) window: Δ < timeoutSlots
         and(
            lessThan(_inputSlotPace, uint8Bytes($1)),
            // K = receipt output index (1 byte of unlock params)
            require(equal(receiptNumConstraints(byte(selfUnlockParameters,0)), u64/4),
                    !!!sellOrder:_receipt_must_have_4_constraints),
            require(parseBytecode(receiptSigLock(byte(selfUnlockParameters,0)), 0x, #sigLock),
                    !!!sellOrder:_receipt_lock_must_be_sigLock),
            require(equal(receiptHolderID(byte(selfUnlockParameters,0)), _consumedOrderIssuer),
                    !!!sellOrder:_receipt_must_pay_seller),
            require(receiptLiteralMatchesInputIdx(byte(selfUnlockParameters,0)),
                    !!!sellOrder:_receipt_literal_must_equal_input_index),
            require(
               lessOrEqualThan(
                  add(
                     _consumedOrderBase,
                     mul(uint8Bytes(_consumedSellAmount), uint8Bytes($0))
                  ),
                  receiptBase(byte(selfUnlockParameters,0))
               ),
               !!!sellOrder:_receipt_base_amount_underpaid
            )
         )
      )
   )
)

// =============================================================================
// buyOrder(amount, price, timeoutSlots)
//
// $0 = amount         (z-encoded, ≤ 8 bytes, > 0)
// $1 = price          (z-encoded, ≤ 8 bytes, > 0)
// $2 = timeoutSlots   (≤ 4 bytes, ≥ _minTimeoutSlots)
//
// Order UTXO produce-side shape:
//   pos 0: amounts (deposit + amount·price; zero inflation)
//   pos 1: indexValues(buyerHolderID, ORDR || tag || 0x00)
//   pos 2: callRedeemer(dexHash, buyOrderFnIdx, amount, price, timeoutSlots)
//   pos 3 (optional): randomizeConsumption(N)
//
// Receipt-output shape on consume (filler is the seller):
//   pos 0: amounts (≥ originalBase − amount·price)
//   pos 1: indexValues(buyerHolderID, …)
//   pos 2: sigLock literal
//   pos 3: inline-data literal == consumed order's input index
//   pos 4: tokenAmount(tag, amount)
//   selfNumConstraints == 5
// =============================================================================

func buyOrder :
or(
   // -------- produce side --------
   and(
      selfIsProducedOutput,
      require(equal(selfBlockIndex, lockConstraintIndex),
              !!!buyOrder:_lock_must_be_at_lockConstraintIndex),
      require(not(isZero($0)),                          !!!buyOrder:_amount_must_be_positive),
      require(lessOrEqualThan(len($0), u64/8),          !!!buyOrder:_amount_must_be_at_most_8_bytes),
      require(not(isZero($1)),                          !!!buyOrder:_price_must_be_positive),
      require(lessOrEqualThan(len($1), u64/8),          !!!buyOrder:_price_must_be_at_most_8_bytes),
      require(lessOrEqualThan(len($2), u64/4),          !!!buyOrder:_timeoutSlots_must_be_at_most_4_bytes),
      require(lessOrEqualThan(_minTimeoutSlots, uint8Bytes($2)),
              !!!buyOrder:_timeoutSlots_below_floor),
      require(equal(len(selfIndexValue(0)), u64/32),
              !!!buyOrder:_issuer_holderID_must_be_32_bytes),
      require(equal(selfIndexValue(0), txHolderID(txSignatureData)),
              !!!buyOrder:_issuer_must_be_tx_signer),
      require(equal(len(selfIndexValue(1)), u64/29),
              !!!buyOrder:_index_entry_must_be_29_bytes),
      require(equal(_entryPrefix(selfIndexValue(1)), _ordrPrefix),
              !!!buyOrder:_index_entry_must_start_with_ORDR),
      require(equal(_entrySide(selfIndexValue(1)), _sideBuy),
              !!!buyOrder:_index_entry_side_byte_must_be_0x00)
   ),
   // -------- consume side --------
   and(
      selfIsConsumedOutput,
      or(
         // reclaim window: Δ ≥ timeoutSlots — delegate fully to sigLock
         // (issuer's holderID lives at selfIndexValue(0) per produce-side rules).
         and(
            lessOrEqualThan(uint8Bytes($2), _inputSlotPace),
            sigLock
         ),
         // counterparty (seller) window: Δ < timeoutSlots
         and(
            lessThan(_inputSlotPace, uint8Bytes($2)),
            require(equal(receiptNumConstraints(byte(selfUnlockParameters,0)), u64/5),
                    !!!buyOrder:_receipt_must_have_5_constraints),
            require(parseBytecode(receiptSigLock(byte(selfUnlockParameters,0)), 0x, #sigLock),
                    !!!buyOrder:_receipt_lock_must_be_sigLock),
            require(equal(receiptHolderID(byte(selfUnlockParameters,0)), _consumedOrderIssuer),
                    !!!buyOrder:_receipt_must_pay_buyer),
            require(receiptLiteralMatchesInputIdx(byte(selfUnlockParameters,0)),
                    !!!buyOrder:_receipt_literal_must_equal_input_index),
            // receipt token amount: must be tokenAmount(consumedTag, $0)
            require(
               equal(
                  parseInlineDataArgument(receiptTokenAmount(byte(selfUnlockParameters,0)), 0, #tokenAmount),
                  _consumedOrderTag
               ),
               !!!buyOrder:_receipt_tokenAmount_tag_mismatch
            ),
            require(
               equal(
                  uint8Bytes(parseInlineDataArgument(receiptTokenAmount(byte(selfUnlockParameters,0)), 1, #tokenAmount)),
                  uint8Bytes($0)
               ),
               !!!buyOrder:_receipt_tokenAmount_amount_mismatch
            ),
            // receipt base balance: ≥ originalBase − amount·price
            require(
               lessOrEqualThan(
                  sub(_consumedOrderBase, mul(uint8Bytes($0), uint8Bytes($1))),
                  receiptBase(byte(selfUnlockParameters,0))
               ),
               !!!buyOrder:_receipt_base_amount_underpaid
            )
         )
      )
   )
)

// =============================================================================
// randomizeConsumption(N)
//
// $0 = N (z-encoded uint, 2 ≤ N ≤ 32)
//
// Optional extra constraint on any order UTXO that lowers contention by
// per-slot lottery. signaturePublicKey || txSlot is the salt: stable for a
// given signer within one slot, so no in-slot grinding.
// =============================================================================

func randomizeConsumption :
or(
   and(
      selfIsProducedOutput,
      require(lessOrEqualThan(_minRandomizeN, uint8Bytes($0)),
              !!!randomizeConsumption:_N_below_floor),
      require(lessOrEqualThan(uint8Bytes($0), _maxRandomizeN),
              !!!randomizeConsumption:_N_above_ceiling)
   ),
   and(
      selfIsConsumedOutput,
      require(
         isZero(
            mod(
               slice(
                  blake2b(concat(signaturePublicKey(txSignatureData), txSlot)),
                  0, 7
               ),
               uint8Bytes($0)
            )
         ),
         !!!randomizeConsumption:_slot_lottery_failed
      )
   )
)
