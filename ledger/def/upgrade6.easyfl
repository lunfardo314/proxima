// Library upgrade 6 (kb/library_upgrade6.md).
//
// Applied by BuildUpgrade6Library on top of the library of upgrade 5: a function
// that exists there is replaced (same number of arguments), a new one is added.
// Nothing else changes.
//
// Everything a transit mints lands in an output whose only spending condition is
// the mining key, so a weak key (a small secret scalar, which makes the VRF cheap)
// leaves every reward open to anyone who knows it. Every output a transit produces
// is pinned element by element, and the full reward is a strict top-up request,
// which lands only in a plain delegation. Every other top-up keeps its meaning. An
// element count is always checked before the elements it covers are read: atPath on
// a missing element panics, and `and` and `or` stop at the first argument that
// settles them.

// Replaced: every miner moves to version 6, which pays the full reward only as a
// top-up of one of its own delegations.
func constMinerVersion : u64/6

// ---- the payouts ----

// Replaced: as in genesis, and the fee is a plain tag-along, three elements, so no
// script can decide where it goes when its sender reclaims it.
// $0 output index of the inclusion fee
func _mineInclusionFee :
and(
   require(equalUint(tupleLenAtPath(concat(pathToProducedOutputs, $0)), u64/3), !!!mine_inclusion_fee_must_be_a_plain_tag-along),
   require(equal(parseBytecode(_mineOutLock($0), 0x), #tagAlong), !!!mine_inclusion_fee_must_be_a_tag_along),
   require(equalUint(_mineOutAmount($0), constMineTagAlongFee), !!!mine_tag_along_fee_must_be_the_fixed_amount)
)

// Replaced: as in genesis, and the opening is a plain sigLock, three elements.
func _mineOpening :
and(
   require(equalUint(numProducedOutputs, u64/3), !!!mine_opening_payout_needs_three_outputs),
   require(equalUint(tupleLenAtPath(concat(pathToProducedOutputs, 1)), u64/3), !!!mine_opening_payout_must_be_a_plain_sigLock),
   require(equal(parseBytecode(_mineOutLock(1), 0x), #sigLock), !!!mine_opening_payout_must_be_sig_locked),
   require(equal(_mineOutIndexValue(1, 0), txHolderID(txSignatureData)), !!!mine_payout_must_go_to_the_transaction_signer),
   require(equalUint(_mineOutAmount(1), _prox(constMineOpeningAmountProx)), !!!mine_opening_amount_must_be_the_opening_amount),
   _mineInclusionFee(2)
)

// Replaced: as in genesis, and the delegation is plain: five elements, nothing
// between the chain constraint and the state.
func _mineNewDelegation :
and(
   require(equalUint(numProducedOutputs, u64/3), !!!mine_delegation_payout_needs_three_outputs),
   require(equalUint(tupleLenAtPath(concat(pathToProducedOutputs, 1)), u64/5), !!!mine_delegation_payout_must_be_a_plain_delegation),
   require(equal(parseBytecode(_mineOutLock(1), 0x), #delegateLock), !!!mine_delegation_payout_must_be_a_delegation),
   require(isChainOriginID(parseInlineDataArgument(_mineOutChain(1), 0, #chain)), !!!mine_delegation_payout_must_be_a_delegation_origin),
   require(equal(_mineOutIndexValue(1, 0), txHolderID(txSignatureData)), !!!mine_delegation_master_must_be_the_transaction_signer),
   require(equalUint(_mineOutAmount(1), _prox(constMineDelegationAmountProx)), !!!mine_delegation_amount_must_be_the_delegation_amount),
   _mineInclusionFee(2)
)

// Replaced: the full reward is a strict top-up request: five elements, the request
// data inline data, so it carries no script, and element 4 an ensureTopUpDelegation
// in its strict form. The guarantor takes it only into a plain delegation whose
// master is the sender, and the tag-along lock makes the sender the signer, which
// is why the sender check of genesis is gone.
func _mineFull :
and(
   require(equalUint(numProducedOutputs, u64/2), !!!mine_full_payout_needs_two_outputs),
   require(equal(parseBytecode(_mineOutLock(1), 0x), #tagAlong), !!!mine_full_payout_must_be_a_tag_along),
   require(equalUint(_mineOutAmount(1), _mineAmount), !!!mine_full_payout_must_be_A),
   require(
      and(
         equalUint(tupleLenAtPath(concat(pathToProducedOutputs, 1)), u64/5),
         parseInlineData(atPath(concat(pathToProducedOutputs, 1, 3))),
         equal(parseBytecode(atPath(concat(pathToProducedOutputs, 1, 4)), 0x), #ensureTopUpDelegation),
         equalUint(len(parseInlineDataArgument(atPath(concat(pathToProducedOutputs, 1, 4)), 0, #ensureTopUpDelegation)), u64/25)
      ),
      !!!mine_full_payout_must_be_a_strict_top-up_request
   )
)

// ---- the top-up guarantor ----

// Replaced: as in genesis, and the argument is either the 24-byte delegation ID or,
// in the strict form, the ID followed by the byte 1. The strict form also requires
// a plain delegation; the mine lock demands it for the full reward. Requests made
// before the upgrade carry the 24-byte form and keep their meaning.
// $0 delegation chain ID, or chain ID || 0x01 for the strict form
func ensureTopUpDelegation :
or(
   and(
      selfIsProducedOutput,
      require(
         or(
            equal(len($0), u64/24),
            and(equal(len($0), u64/25), equal(byte($0, 24), 1))
         ),
         !!!wrong_chain_id
      )
   ),
   and(
      selfIsConsumedOutput,
      if(
         selfHasLockType(#tagAlong),
         or(
            greaterOrEqualThan(selfInputSlotPace, constTagAlongSlots),
            _ensureTopUpDelegation($0)
         ),
         _ensureTopUpDelegation($0)
      )
   )
)

// Replaced: as in genesis, the delegation ID being the first 24 bytes of the
// argument, and two checks more. The predecessor is locked by delegateLock, so the
// top-up runs through the delegate lock and its master check: the frozen mark and
// the 3-byte unlock alone are met by any chain carrying a delegateLockState under a
// lock that ignores its unlock parameters (sigLock). In the strict form the
// predecessor is also plain, five elements, so no extra element can carry a script
// deciding where the delegation goes when its master spends it.
// $0 delegation chain ID, or chain ID || 0x01 for the strict form
func _ensureTopUpDelegation :
and(
  require(
     equal(parseInlineDataArgument(_topUpSuccessorChainConstraint, 0, #chain), slice($0, 0, 23)),
     !!!ensureTopUpDelegation:_delegationID_is_wrong
  ),
  require(
     equal(parseBytecode(consumedConstraintByIndex(_topUpPredecessorIndex, lockConstraintIndex), 0x), #delegateLock),
     !!!ensureTopUpDelegation:_predecessor_must_be_a_delegation
  ),
  require(
     or(
        equal(len($0), u64/24),
        equalUint(tupleLenAtPath(concat(pathToConsumedOutputs, _topUpPredecessorIndex)), u64/5)
     ),
     !!!ensureTopUpDelegation:_strict_top-up_needs_a_plain_delegation
  ),
  require(
     equal(parseInlineDataArgument(_topUpSuccessorState, 1, #delegateLockState), 1),
     !!!ensureTopUpDelegation:_delegation_successor_is_not_frozen
  ),
  require(
     and(
        equal(len(_topUpPredecessorLockUnlock), u64/3),
        equal(byte(_topUpPredecessorLockUnlock, 2), selfOutputIndex)
     ),
     !!!ensureTopUpDelegation:_delegation_must_be_unlocked_with_a_reference_to_the_request
  )
)

// Replaced: as in genesis, comparing only the delegation ID, the first 24 bytes of
// the request's argument, so the strict form is a top-up like any other.
// $0 master holder ID (32 bytes)
func _topUpAuthorised :
and(
   require(
      equal(slice(parseInlineDataArgument(_allowanceConstraint, 0, #ensureTopUpDelegation), 0, 23), _selfEffectiveChainID),
      !!!top-up_names_a_different_delegation
   ),
   require(
      equal(parseBytecode(consumedConstraintByIndex(_allowanceRefIndex, lockConstraintIndex), 0x), #tagAlong),
      !!!top-up_must_be_carried_by_a_tag-along_output
   ),
   require(
      equal(_allowanceRefSenderID, $0),
      !!!top-up_not_authorised_by_the_delegation_master
   ),
   require(lessOrEqualThan(selfTokenBalanceValue, _amountOnSuccessor), !!!delegated_amount_should_not_decrease)
)
