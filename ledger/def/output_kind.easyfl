// =============================================================================
// Output-kind index. Spec: claude/output_kind_index.md.
//
// A 4-byte ASCII "kind tag" is written as the LAST member of the index-values
// tuple (output element index 1) of every chain (and the stem output). Because
// each non-empty index-values member produces one trie row under
// TriePartitionControllers, a kind becomes enumerable by a prefix scan over its
// tag value — without walking every chain.
//
// Generalizes the DEX `ORDR` prefix idiom (lock_dex_orders.easyfl). DEX entries
// already keep their kind tag (`ORDR||tag||side`) as the last index-values
// member, so they need no change here.
//
// Chain family: every chain tag starts with '$' (0x24); the chain constraint
// enforces only that family invariant (so generic chains, which have no role
// constraint, are still tagged). Role constraints enforce the exact tag.
// =============================================================================

// ---- tag constants (4-byte ASCII) -----------------------------------------

func _chainFamilyByte : 0x24         // '$'
func _genChainTag     : 0x2447454e   // "$GEN"
func _foundryTag      : 0x24464e44   // "$FND"
func _seqTag          : 0x24534551   // "$SEQ"
func _delegateTag     : 0x24444c47   // "$DLG"
func _stemTag         : 0x5354454d   // "STEM"

// ---- last index-values member accessor ------------------------------------

// number of members in this output's index-values tuple
func _selfNumIndexValues : tupleLenAtPath(concat(selfOutputPath, indexValuesConstraintIndex))

// 1-byte index of the last index-values member (count - 1, low byte).
// Mirrors the `byte(sub(tupleLenAtPath(...), u64/1), 7)` idiom in
// lock_dex_orders.easyfl.
func _selfLastIndexValueIndex : byte(sub(_selfNumIndexValues, u64/1), 7)

// the last index-values member of this output (where the kind tag lives)
func _selfLastIndexValue : selfIndexValue(_selfLastIndexValueIndex)

// ---- enforcement helpers ---------------------------------------------------

// Chain-family invariant: the last index-values member is a 4-byte tag whose
// first byte is '$'. Enforced by the chain constraint for EVERY chain, so even
// generic chains (no role constraint) carry a `$xxx` tag.
func _enforceChainFamily : and(
    require(equal(len(_selfLastIndexValue), u64/4),            !!!chain_kind_tag_must_be_4_bytes),
    require(equal(byte(_selfLastIndexValue, 0), _chainFamilyByte), !!!chain_kind_tag_must_start_with_dollar)
)

// Exact-tag assertion for role constraints / stem.
// $0 - expected 4-byte tag value
func _enforceKindTag : require(equal(_selfLastIndexValue, $0), !!!wrong_or_missing_kind_tag)
