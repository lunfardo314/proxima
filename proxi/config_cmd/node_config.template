# Configuration file for the Proxima node

# Peering configuration
peering:
  # libp2p host data:
  host:
    # host private key. Should not be used to protect tokens
    id_private_key: {{.HostPrivateKey}}
    # host ID is derived from the host ID public key.
    id: {{.HostID}}
    # port to connect from other peers
    port: {{.HostPort}}
    # Optional list of public IP addresses this node advertises itself at (on the
    # peering port above). The node already advertises the IPs found on its local
    # network interfaces, so this is only needed when the node is reachable through
    # NAT / port mapping and its public IP is on no local interface — then neither
    # interface enumeration nor libp2p observed-address discovery can find it, and
    # the node stays invisible to peers (and to the network-connectivity map) until
    # it is told its public IP here. Just the IP(s); the peering port and host ID
    # are filled in automatically.
    # external_addresses:
    #   - 203.0.113.7

  # YAML dictionary (map) of statically pre-configured peers. Also used in the peering boostrap phase by Kademlia DHT.
  # Empty is valid for: (a) the first bootstrap node in a multi-node network (peers will discover it via autopeering),
  # and (b) a single-node dev network when the sequencer runs with `standalone: true`.
  # Otherwise at least 1 static peer is required.
  # Each static peer is specified as a pair <name>: <multiaddr>, where:
  # -- <name> is unique mnemonic name used for convenience locally
  # -- <multiaddr> is the libp2p multi-address in the form '/ip4/<IPaddr or URL>/<port>/quic-v1/p2p/<hostID>'
  # for more info see https://docs.libp2p.io/concepts/fundamentals/addressing/
  peers:
    # Entry format -> <node name>: /ip4/<IP host>/udp/<peering port>/quic-v1/p2p/<p2p host ID>
{{if .Standalone}}    # A standalone dev network peers with nobody. The public Proxima nodes:
{{range .PublicNodes}}    # {{.Name}}: {{.MultiAddr}}
{{end}}{{else}}    # The public Proxima nodes. Comment out any this node should not peer with.
{{range .PublicNodes}}    {{.Name}}: {{.MultiAddr}}
{{end}}{{end}}
  # Maximum number of peers which may be connected to via the automatic peer discovery
  # max_dynamic_peers > 0 means automatic peer discovery (autopeering) is enabled, otherwise disabled
  max_dynamic_peers: {{.MaxDynamicPeers}}
  # allow local IPs to be used for autopeering. Default false; a local or dev
  # network on private addresses needs it true
  # allow_local_ips: true

  # lppConnectivity: operational network-mapping overlay. Each node periodically
  # publishes and gossips its peer round-trip-time view (keyed by privacy-preserving
  # masked names) so the whole network adjacency can be downloaded from any node via
  # /api/v1/get_connectivity_map. Analysis-only, never a consensus input. Enabled by
  # default; uncomment to opt out.
  # connectivity:
  #   disable: true

# Trusted node API endpoints, used for fetching ledger data from the network.
# Shared by BOTH forward-sync (requesting branch lists for catch-up) and snapshot
# acquisition (downloading a snapshot when one is needed). This is the single list of
# "where to fetch from" — it is owned by neither subsystem. Self URLs (localhost with
# own api.port) are automatically skipped. A source must be a synced node with its API
# reachable; cycles to the next source on failure.
{{if .Standalone}}# A standalone dev network fetches from nobody. The public Proxima nodes:
# sources:
{{range .PublicNodes}}#   - "{{.APIEndpoint}}"
{{end}}{{else}}sources:
{{range .PublicNodes}}  - "{{.APIEndpoint}}"
{{end}}{{end}}
# Node's API config
api:
    # server port
  port: {{.APIPort}}
  # do not start the API server at all. Recommended on a sequencer node: its API
  # serves no purpose to the network and every open port is exposed surface.
  # disable: true
  # WebSocket streaming (DAG visualizer)
  # ('streaming' is accepted as a legacy synonym of 'dag_streaming')
{{if .Standalone}}  # Enabled by default on a standalone dev network, where the DAG visualizer is
  # the main way to watch the single node. The long TTL keeps a visualizer tab
  # connected for a whole dev session.
  dag_streaming:
    enable: true
    # max simultaneous WebSocket connections (default: 5)
    max_connections: 5
    # connection rotation timeout in minutes (default: 5)
    connection_ttl_minutes: 120
{{else}}  # dag_streaming:
  #   enable: true
  #   # max simultaneous WebSocket connections (default: 5)
  #   max_connections: 5
  #   # connection rotation timeout in minutes (default: 5)
  #   connection_ttl_minutes: 5
{{end -}}

snapshot:
  enable: false
    # The single directory for snapshot files, used by both snapshot creation and restore.
    # Default "" means current working directory.
    # On startup with a missing, corrupted or hopelessly outdated DB, the node restores from
    # a snapshot. It prefers one downloaded from 'sources' (downloads land in this directory),
    # and falls back to the newest snapshot already here only when 'sources' is empty or every
    # download fails. If neither yields a snapshot, the node refuses to start.
  directory: ""
    # 176 slots means snapshot is every ~30 min (at 10.24 sec/slot)
  period_in_slots: 176
    # keep latest up to 2 snapshots, older ones will be purged
  keep_latest: 2
    # enable snapshot download API endpoint (independent of snapshot creation)
  enable_download_api: false
    # always serve the latest snapshot over the API, skipping the safety gate.
    # When false (default), the snapshot is served only if the node is synced,
    # the snapshot is >=64 slots old (or within 64 slots of genesis), and its
    # branch is in the past of the node's latest reliable branch. Otherwise the
    # API refuses with diagnostics.
  always_serve: false

# Automatic snapshot restore for state management
# When enabled, periodically restarts the node and restores from latest snapshot
# This cleans up old historical state, keeping only the latest
snapshot_restore:
  enable: false
  # Period between restores in slots (~24h = 8438 slots at 10.24 sec/slot)
  period_slots: 8438
  # Randomization window in slots (~4h = 1406 slots) to avoid mass restarts
  window_slots: 1406
  # TTL in minutes - if restore takes longer, assume failure and reset
  ttl_minutes: 10
  # Optional: override snapshot directory (default: uses snapshot.directory)
  # Can point to another node's snapshot directory for shared snapshots
  # snapshot_directory: /path/to/other/node/snapshot
  # Optional: separate log file for restore activity (stats, duration, etc.)
  # log_file: .snapshot_restore.log

# transaction processing engine
# workflow:
#   # cap on concurrent sequencer-attacher goroutines (gates unsolicited gossip;
#   # forward-sync/pulled attachers are exempt). 0 or unset = auto:
#   # max(20, 10 x GOMAXPROCS). Set a positive value to pin it.
#   max_concurrent_attachers: 0

# logger config
# logger.previous can be 'erase' or 'save'
logger:
  # global verbosity: default level for all topics (0=essential, 1=normal, 2=verbose)
  verbosity: 0
  # directory for log files (live, rotated and crash logs). Default "" means the working directory.
  # Several nodes on one machine may share one directory; distinct 'output' basenames keep them apart.
  directory: ""
  output: proxima.log
  # options: 'erase' (previous will be erased), 'save' (previous will be saved and then deleted)
  # Otherwise or when absent: log will be appended to the same existing file
  previous: save
  keep_latest_logs: 2
  # per-topic verbosity overrides. Overrides global verbosity for specific topics.
  # Available topics (with their levels):
  #   lifecycle         - work process start/stop (0)
  #   tag_along         - tag-along output processing (0: permanent failures, 1: additions/transient)
  #   freeze_delegation - delegation freeze operations (1)
  #   branch_attach     - branch transaction attachment status (1)
  #   seq_attach        - sequencer transaction attachment status (1)
  #   branch_commit     - branch state commit/orphan (1)
  topics:
    branch_commit: 1
    # tag_along: 1
    # freeze_delegation: 1
    # branch_attach: 1

# Other parameters used for tracing and debugging
# Prometheus metrics exposure
metrics:
  # expose Prometheus metrics yes/no
  enable: false
  port: 14000

{{if .IncludeTrace}}
# list of enabled trace tags. When enabled, it forces tracing of the specified module.
# It may be very verbose, so it is only used For debugging.
# For more available trace tags search the code for "TraceTag"
trace_tags:
#  - autopeering
#  - pull_server
#  - txinput
#  - txStore
{{end}}
{{if .IncludeTxLogger}}
# Transaction logger
txlogger:
  enable_on_start: {{if .TxLoggerEnabled}}true{{else}}false{{end}}
  level: "all"
  ttl_hours: 1
  enable_on_off_api: {{if .TxLoggerEnabled}}true{{else}}false{{end}}
{{end}}
{{if .IncludeSequencer}}{{template "sequencer_block" .}}{{end}}
# Node-global branch-health relief window.
# Branch healthiness (coverage delta vs total supply) is NOT enforced on the
# immutable ledger; it is enforced in Go: the attacher rejects unhealthy branches,
# a sequencer refuses to issue them, and LRB selection ignores them. Within slots
# [from_slot, to_slot] the healthy-branch fraction below is used at all those sites
# instead of the ledger fraction. Intended for a coordinated restart of a network
# from an old snapshot, where expired frozen coverage can otherwise make a healthy
# branch impossible to reconstruct (deadlock). Relief is a network-wide convention:
# every participating node must configure exactly the same window and fraction, or
# the nodes disagree on which branches are acceptable. Absent section means the
# ledger fraction everywhere.
# health_relief:
#   from_slot: 8740
#   to_slot: 8800
#   numerator: 4
#   denominator: 12

# Node-global per-sequencer coverage lower-bound enforcement switch.
# The lower-bound CONSTANT stays on the ledger, but enforcement (attacher rejects a
# branch whose sequencer coverage is below it; a sequencer refuses to issue one) is
# in Go. Set this to true to disable that enforcement on this node, for the same
# coordinated snapshot-restart scenario as the health relief window (expired frozen
# coverage). The upper bound stays a ledger constraint and is unaffected.
# suppress_coverage_contribution_lower_bound: false


# Forward-sync configuration (sequential branch-by-branch catch-up for large gaps).
# Activation is governed ENTIRELY by whether 'sources' above is populated: with at least one
# source forward-sync runs (catch-up + fork detection); with none it is DISABLED and the node
# relies on recursive solidification alone (a larger depth cap). A disabled node logs a loud
# warning at startup, and if its local state is farther behind than recursion can bridge, an
# attacher hitting the depth cap graceful-shuts-down instead of wedging (configure 'sources' or
# restore from a fresher snapshot). There is no separate on/off flag. Bootstrap/standalone nodes
# run with no 'sources' by design.
# sync:
#   # Triggering is automatic and has no thresholds: forward-sync runs exactly while
#   # at least one attacher is stalled at the recursion depth cap (i.e. the node is
#   # more than ~50 branches behind). There are no gap thresholds to configure.
#   # pull k-th branch ahead to parallelize past cone solidification (default: 5)
#   pull_ahead: 5
#   # max branches to commit per sync tick before forcing GC (default: 10)
#   # lower values reduce memory spikes during rapid forward-sync at the cost of slower catch-up
#   commit_batch: 10

# Memory management
# When limit_mb > 0, sets Go's soft GC limit (debug.SetMemoryLimit) and starts
# a watchdog that initiates graceful shutdown when heap reaches the limit (stress = 100%).
# gogc controls Go's GC frequency (default 50, Go default is 100). Lower values make GC
# run more often, keeping the heap compact and reducing sensitivity to allocation spikes.
# memory:
#   # soft memory limit in MB; 0 = disabled (default)
#   limit_mb: 0
#   # GOGC percentage (default: 50). Lower = more frequent GC, less spike sensitivity
#   gogc: 50

{{define "sequencer_block"}}# Sequencer configuration (optional)
sequencer:
    # optional sequencer name (1-6 characters). Stored on-chain in every sequencer transaction.
    # Once set on-chain (via 'proxi node seq set-params --name'), the on-chain name takes priority.
  {{if .HasSeqName}}name: {{.SeqName}}{{else}}# name: <sequencer name (1-6 chars)>{{end}}
    # start sequencer true/false
  enable: {{.SeqEnable}}
  # produce_branches: issue branch transactions and compete for the branch inflation
  # bonus. Default false: the sequencer never branches. A non-branching sequencer still
  # captures chain inflation, services tag-along and delegation freezing, and gets its
  # milestones into the ledger state via other sequencers' branches; it stops raising its
  # coverage once its own milestone reaches healthy coverage. Branching is opt-in because
  # only a few branches per slot are needed: every extra branching sequencer adds load and
  # bonus competition without adding security. Opting in costs CPU and latency headroom.
  # The bootstrap sequencer always branches regardless of this flag.
  # produce_branches: false
    # chain ID of the sequencer
    # Sequencer chain is created by 'proxi node mkchain' command
  chain_id: {{.SeqChainID}}
  # path to the controller key file (JSON keystore format, created by 'proxi util key generate')
  controller_key_file: {{.ControllerKeyFile}}
  # sequencer pace. Distance in ticks between two subsequent sequencer transactions
  # cannot be less than the sequencer pace value set by the ledger
  pace: 12
  # maximum tag-along inputs per milestone (default: 15). Controls batch size.
  # 0 means the sequencer accepts NO tag-along inputs (does not service tag-along).
  max_tag_along_inputs: 15
  # target tag-alongs to drain per slot (default: 100, ~10 TPS per sequencer).
  # Together with max_tag_along_inputs, controls how many drain milestones per slot.
  tag_along_drain_rate: 100
  # approximate per-epoch cap on the number of delegations the sequencer freezes
  # (default: 300). Freezing a delegation into a reachable epoch already holding this
  # many frozen delegations is refused (it stays unfrozen and is retried later).
  # 0 means the sequencer accepts NO delegations (freezes none).
  max_frozen_delegations: 300
  # write separate sequencer log (default: false)
  logging: false
  # if logging = true, duplicate sequencer log messages to the node's log (default: false)
  global_logging: false
  # force_activity: always issue branch + milestone regardless of throttle pressure.
  # Use for bootstrap sequencers that must keep producing to maintain network liveness.
  # force_activity: false
  # disable_throttle: disable tag-along budget throttling entirely.
  # Budget always stays at full (2/3 of consensus). For debugging.
  # disable_throttle: false
  # standalone: bypass the libp2p connectivity check before submitting milestones.
  # Use ONLY for single-node dev networks (no peers by design). NEVER enable on a
  # networked sequencer: it would allow building one-sided forks during a partition.
  {{if .Standalone}}standalone: true{{else}}# standalone: false{{end}}
{{end}}
